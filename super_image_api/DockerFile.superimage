# Dockerfile
FROM python:3.12-slim

WORKDIR /app

# 1. Установка системных зависимостей
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 2. Обновляем pip и устанавливаем зависимости БЕЗ указания версий
RUN python -m pip install --no-cache-dir --upgrade pip

# 3. Устанавливаем все зависимости одной командой (без версий)
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    numpy \
    pydantic \
    python-multipart \
    requests \
    opencv-python-headless \
    Pillow

# 4. Установка PyTorch для CPU (указываем только CPU версию)
RUN pip install --no-cache-dir \
    torch torchvision \
    --index-url https://download.pytorch.org/whl/cpu

# 5. Установка super-image
RUN pip install --no-cache-dir \
    super-image

# 6. Копируем код
COPY ./src/super_image_processor.py /app/
COPY ./super_image_api/super_image_api.py /app/

EXPOSE 5003

CMD ["uvicorn", "super_image_api:app", "--host", "0.0.0.0", "--port", "5003", "--workers", "1"]